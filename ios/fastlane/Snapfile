devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
])

languages(["en-US"])

scheme("Spark")

output_directory("./fastlane/screenshots")

clear_previous_screenshots(true)

override_status_bar(true)

# SwiftLint's SPM build-tool plugin needs a one-time GUI trust approval that
# headless xcodebuild never gets, and xcodegen regenerates a fresh .xcodeproj
# each run so that trust never persists. Skip validation instead.
xcargs("-skipPackagePluginValidation")
